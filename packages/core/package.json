{
  "name": "@inicrea/bikram-sambat-core",
  "version": "0.1.0",
  "description": "Bikram Sambat (Nepali calendar) date conversion for JavaScript — pure TypeScript, zero dependencies, works in Node, browsers and React Native.",
  "keywords": [
    "bikram-sambat", "nepali-date", "nepali-calendar", "bs-to-ad", "ad-to-bs",
    "nepal", "date-converter", "bikram", "nepali", "calendar"
  ],
  "license": "MIT",
  "author": "Inicrea Technologies",
  "repository": { "type": "git", "url": "git+https://github.com/Inicrea-Technologies-Pvt-Ltd/bikram-sambat.git", "directory": "packages/core" },
  "homepage": "https://github.com/Inicrea-Technologies-Pvt-Ltd/bikram-sambat#readme",
  "bugs": { "url": "https://github.com/Inicrea-Technologies-Pvt-Ltd/bikram-sambat/issues" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
